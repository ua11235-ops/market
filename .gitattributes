# Normalise line endings in the repository.  Without this, a Windows checkout
# with core.autocrlf=true rewrites every file to CRLF while the blobs stay LF,
# which makes whole-file rewrites show up as "every line changed" in reviews.
* text=auto eol=lf

# Binary assets must never be line-ending converted.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary

# PowerShell scripts keep CRLF: Windows PowerShell 5.1 needs the UTF-8 BOM to
# read the Chinese comments correctly, and the BOM pairs with CRLF here.
*.ps1 text eol=crlf
